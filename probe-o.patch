@@ -0,0 +1,87 @@
+#pragma once
+
+struct PackedCandidate {
+    uint64_t id, person, value;
+};
+static_assert(sizeof(PackedCandidate) == 24);
+
+template<class Candidate, class Storage> struct CandidateCodec {
+    struct Escapes {};
+    CandidateCodec(size_t, const Window&) {}
+    Storage encode(const Candidate& row, Escapes&) const { return row; }
+    uint64_t key(const Storage& row) const { return row.id; }
+    int64_t ingest(const Storage& row) const { return row.ingest; }
+    const typename Candidate::Survivor& payload(const Storage& row) const { return row.payload; }
+    Candidate expand(const Storage& row, size_t) const { return row; }
+};
+
+template<> class CandidateCodec<CompactCandidate, PackedCandidate> {
+    static constexpr uint64_t no_purchase = uint64_t{1} << 63;
+    static constexpr uint64_t time_mask = 0x7fffffff00000000ULL;
+    static constexpr unsigned seconds_bits = 11;
+    static constexpr uint64_t seconds_mask = (1u << seconds_bits) - 1;
+    static constexpr int32_t unavailable = INT32_MIN;
+    uint64_t reclaim_mask_;
+    int64_t base_seconds_;
+
+    static const CompactCandidate& escaped(const PackedCandidate& row) {
+        return *reinterpret_cast<const CompactCandidate*>(uintptr_t(row.person));
+    }
+
+public:
+    using Escapes = std::deque<CompactCandidate>;
+
+    CandidateCodec(size_t buckets, const Window& window)
+        : reclaim_mask_(std::min<uint64_t>(buckets - 1, UINT16_MAX)), base_seconds_(window.start / 1000) {}
+
+    PackedCandidate encode(const CompactCandidate& row, Escapes& escapes) const {
+        const uint64_t key = row.id & ~reclaim_mask_;
+        const uint64_t value = row.payload.value;
+        const uint32_t price = uint32_t(value) & price_mask;
+        const uint32_t category = uint8_t(value >> 24);
+        const bool missing = row.ingest == bad_time;
+        const int64_t seconds = missing ? unavailable : row.ingest / 1000 - base_seconds_;
+        if (!(value & no_purchase) && (missing || row.ingest % 1000 == 0)) {
+            if (!price && !category && (missing || (seconds > unavailable && seconds <= INT32_MAX)))
+                return {key, row.payload.person, no_purchase | (value & time_mask) | uint32_t(seconds)};
+            if (price && price <= UINT16_MAX && category < 32 && !missing &&
+                uint64_t(seconds) <= ((reclaim_mask_ << seconds_bits) | seconds_mask)) {
+                uint64_t delta = seconds;
+                return {key | (delta >> seconds_bits), row.payload.person,
+                        (value & time_mask) | (delta & seconds_mask) << 21 | uint64_t(category) << 16 | price};
+            }
+        }
+        escapes.push_back(row);
+        return {key, reinterpret_cast<uintptr_t>(&escapes.back()), 0};
+    }
+
+    uint64_t key(const PackedCandidate& row) const { return row.id & ~reclaim_mask_; }
+
+    int64_t ingest(const PackedCandidate& row) const {
+        if (!row.value) return escaped(row).ingest;
+        int64_t seconds;
+        if (row.value & no_purchase) {
+            seconds = std::bit_cast<int32_t>(uint32_t(row.value));
+            if (seconds == unavailable) return bad_time;
+        } else {
+            seconds = ((row.id & reclaim_mask_) << seconds_bits) | ((row.value >> 21) & seconds_mask);
+        }
+        return (base_seconds_ + seconds) * 1000;
+    }
+
+    CompactEvent payload(const PackedCandidate& row) const {
+        if (!row.value) return escaped(row).payload;
+        uint64_t value = row.value & time_mask;
+        if (!(row.value & no_purchase))
+            value |= ((row.value >> 16) & 31) << 24 | uint16_t(row.value);
+        return {row.person, value};
+    }
+
+    CompactCandidate expand(const PackedCandidate& row, size_t bucket) const {
+        CompactCandidate result;
+        result.id = key(row) | (bucket & reclaim_mask_);
+        result.ingest = ingest(row);
+        result.payload = payload(row);
+        return result;
+    }
+};
