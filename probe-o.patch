index 0000000000000000000000000000000000000000..a402b82403c67c833d363b9bc1719068b081a837
--- /dev/null
+++ b/event_prefix.hpp
@@ -0,0 +1,79 @@
+#pragma once
+
+struct EventPrefix {
+    static constexpr size_t id_size = 9;
+    const char* event_id;
+    const char* user_id;
+    int64_t time, ingest;
+};
+
+using EventTemplateBytes = uint8_t __attribute__((vector_size(16)));
+
+template<const char (&Shape)[17]> bool event_template_matches(const char* text) {
+    constexpr auto pattern = [] {
+        struct Pattern { std::array<uint8_t, 16> base, limit; };
+        Pattern result{};
+        for (size_t i = 0; i < 16; ++i) {
+            bool digit = Shape[i] == '0', any = Shape[i] == '?';
+            result.base[i] = any ? 0 : Shape[i];
+            result.limit[i] = digit ? 9 : any ? 255 : 0;
+        }
+        return result;
+    }();
+    EventTemplateBytes bytes;
+    std::memcpy(&bytes, text, sizeof(bytes));
+    auto base = std::bit_cast<EventTemplateBytes>(pattern.base);
+    auto limit = std::bit_cast<EventTemplateBytes>(pattern.limit);
+    auto invalid = std::bit_cast<std::array<uint64_t, 2>>((bytes - base) > limit);
+    return (invalid[0] | invalid[1]) == 0;
+}
+
+inline constexpr char event_iso_template[] = "0000-00-00T00:00";
+inline constexpr char event_epoch_template[] = "0000000000000,??";
+
+int64_t event_template_iso(const char* text, bool offset) {
+    if (!event_template_matches<event_iso_template>(text) || text[16] != ':') return bad_time;
+    auto pair = [](const char* p) { return 10 * (p[0] - '0') + (p[1] - '0'); };
+    int h = pair(text + 11), m = pair(text + 14), s = two_digits(text + 17);
+    if (h > 23 || m > 59 || unsigned(s) > 59) return bad_time;
+    int zone = 0;
+    if (offset) {
+        zone = offset_seconds(text);
+        if (zone == bad_offset) return bad_time;
+    } else if (text[19] != 'Z') {
+        return bad_time;
+    }
+    int64_t midnight = calendar_midnight(pair(text) * 100 + pair(text + 2), pair(text + 5), pair(text + 8));
+    return midnight == bad_time ? bad_time : midnight + (h * 3600 + m * 60 + s - zone) * 1000;
+}
+
+template<CsvQuotes Quotes> bool read_event_prefix(const IndexedCsvRow<Quotes>& row, EventPrefix& prefix) {
+    const auto* ends = row.ends;
+    constexpr unsigned id_size = EventPrefix::id_size;
+    if (ends[0] != row.begin + id_size || ends[1] != row.begin + 2 * id_size + 1) return false;
+    unsigned ts_begin = row.begin + 2 * (id_size + 1);
+    unsigned ts_size = ends[2] - ts_begin;
+    if ((ts_size != 13 && ts_size != 20 && ts_size != 25) || ends[3] != ts_begin + ts_size + 21) return false;
+    if constexpr (Quotes != CsvQuotes::None) {
+        if (row.data[ends[3] + 1] == '"' || row.data[(ends[4] & csv_end_mask) + 1] == '"' ||
+            row.data[(ends[5] & csv_end_mask) + 1] == '"') return false;
+    }
+    const char* id = row.data + row.begin;
+    const char* user = id + id_size + 1;
+    if (id[0] != 'e' || user[0] != 'u') return false;
+    const char* ts = row.data + ts_begin;
+    int64_t time;
+    if (ts_size == 13) {
+        if (!event_template_matches<event_epoch_template>(ts)) return false;
+        time = epoch_millis_13<true>(ts);
+    } else {
+        time = event_template_iso(ts, ts_size == 25);
+        if (time == bad_time) return false;
+    }
+    int64_t ingest = event_template_iso(ts + ts_size + 1, false);
+    if (ingest == bad_time) return false;
+    prefix = {id, user, time, ingest};
+    return true;
+}
+
+inline bool read_event_prefix(const ScalarCsvRow<7>&, EventPrefix&) { return false; }
