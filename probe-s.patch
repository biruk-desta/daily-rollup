+template<bool Fast> bool session_click_id_after(const char* a, const char* b) {
+    if constexpr (Fast) {
+        if (a[1] != ',' && a[1] != '"' && b[1] != ',' && b[1] != '"') {
+            uint64_t left, right;
+            std::memcpy(&left, a, sizeof(left));
+            std::memcpy(&right, b, sizeof(right));
+            auto has_byte = [](uint64_t word, uint8_t byte) {
+                word ^= uint64_t(byte) * 0x0101010101010101ULL;
+                return (word - 0x0101010101010101ULL) & ~word & 0x8080808080808080ULL;
+            };
+            if (!has_byte(left, ',') && !has_byte(right, ',') &&
+                !has_byte(left, '"') && !has_byte(right, '"')) {
+                if (left == right) return click_id_after(a + sizeof(left), b + sizeof(right));
+                if constexpr (std::endian::native == std::endian::little)
+                    return __builtin_bswap64(left) > __builtin_bswap64(right);
+                else return left > right;
+            }
+        }
+    }
+    return click_id_after(a, b);
+}
