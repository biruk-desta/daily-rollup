diff --git a/csv_index.hpp b/csv_index.hpp
new file mode 100644
index 0000000..e156ddd
--- /dev/null
+++ b/csv_index.hpp
@@ -0,0 +1,146 @@
+#pragma once
+
+struct CsvMarkers { uint64_t commas, lines, quotes; };
+
+// Index enough text to keep the separator streams and the subsequent field
+// loads in cache. An extra slot at the end is a sentinel for malformed rows.
+class CsvIndex {
+public:
+    static constexpr size_t batch_bytes = 16 * 1024;
+
+private:
+    uint16_t ends_[batch_bytes + 8], lines_[batch_bytes + 8], errors_[batch_bytes + 1];
+    uint16_t* end_ = ends_;
+    uint16_t* line_ = lines_;
+    uint16_t* error_ = errors_;
+    bool after_separator_ = true, after_open_ = false, after_close_ = false, in_quoted_field_ = false;
+
+    static void append(uint16_t*& out, unsigned base, uint64_t mask) {
+        while (mask) {
+            *out++ = base + std::countr_zero(mask);
+            mask &= mask - 1;
+        }
+    }
+
+public:
+    void block(unsigned base, CsvMarkers marks) {
+        uint64_t sep = marks.commas | marks.lines;
+        uint64_t open = marks.quotes & ((sep << 1) | after_separator_);
+        uint64_t close = marks.quotes ^ open;
+        uint64_t after_open = (open << 1) | after_open_;
+        uint64_t after_close = (close << 1) | after_close_;
+        // Borrow from each opening position through to its next separator.
+        // A separator whose bit is consumed must follow a closing quote.
+        uint64_t remaining = sep - open;
+        uint64_t wrapped = sep & ~(remaining - in_quoted_field_);
+        uint64_t bad = (after_close & ~sep) | (after_open & sep) | ((after_close ^ wrapped) & sep);
+        in_quoted_field_ = (sep < open) | (remaining < in_quoted_field_);
+        after_separator_ = sep >> 63;
+        after_open_ = open >> 63;
+        after_close_ = close >> 63;
+        append(end_, base, sep);
+        append(line_, base, marks.lines);
+        append(error_, base, bad);
+    }
+
+    template<size_t N, class Row> void parse(const char* data, Row& row) {
+        std::fill_n(end_, N, UINT16_MAX);
+        *error_ = UINT16_MAX;
+        auto field = ends_;
+        auto error = errors_;
+        unsigned begin = 0;
+        for (auto line = lines_; line != line_; ++line) {
+            unsigned end = *line;
+            if (field[N - 1] == end && *error > end) {
+                Fields<N> fields;
+                unsigned start = begin;
+                for (size_t i = 0; i < N; ++i) {
+                    unsigned quoted = data[start] == '"';
+                    fields[i] = View(data + start + quoted, field[i] - start - 2 * quoted);
+                    start = field[i] + 1;
+                }
+                row(View(data + begin, end - begin), fields);
+                field += N;
+            } else {
+                while (*field <= end) ++field;
+                while (*error <= end) ++error;
+            }
+            begin = end + 1;
+        }
+    }
+};
+
+#if defined(__x86_64__)
+__attribute__((target("avx2")))
+inline CsvMarkers csv_avx2(const char* p) {
+    auto lo = avx2_markers(p), hi = avx2_markers(p + 32);
+    return {lo.commas | (hi.commas << 32), lo.newlines | (hi.newlines << 32), lo.quotes | (hi.quotes << 32)};
+}
+
+__attribute__((target("avx512bw")))
+inline CsvMarkers csv_avx512(const char* p) {
+    auto marks = avx512_markers(p);
+    return {marks.commas, marks.newlines, marks.quotes};
+}
+#elif defined(__aarch64__)
+inline CsvMarkers csv_neon(const char* p) {
+    auto* bytes = reinterpret_cast<const uint8_t*>(p);
+    uint8x16_t x0 = vld1q_u8(bytes), x1 = vld1q_u8(bytes + 16);
+    uint8x16_t x2 = vld1q_u8(bytes + 32), x3 = vld1q_u8(bytes + 48);
+    const uint8x16_t weights{1, 2, 4, 8, 16, 32, 64, 128, 1, 2, 4, 8, 16, 32, 64, 128};
+    auto mask = [&](uint8_t marker) {
+        auto target = vdupq_n_u8(marker);
+        auto a = vandq_u8(vceqq_u8(x0, target), weights);
+        auto b = vandq_u8(vceqq_u8(x1, target), weights);
+        auto c = vandq_u8(vceqq_u8(x2, target), weights);
+        auto d = vandq_u8(vceqq_u8(x3, target), weights);
+        auto pairs = vpaddq_u8(vpaddq_u8(a, b), vpaddq_u8(c, d));
+        return vgetq_lane_u64(vreinterpretq_u64_u8(vpaddq_u8(pairs, pairs)), 0);
+    };
+    return {mask(','), mask('\n'), mask('"')};
+}
+#endif
+
+template<auto Mark> [[gnu::always_inline]] inline void csv_blocks_impl(CsvIndex& index, View batch) {
+    unsigned offset = 0;
+    for (; offset + 64 <= batch.size(); offset += 64) index.block(offset, Mark(batch.data() + offset));
+    if (offset < batch.size()) {
+        alignas(64) char tail[64]{};
+        std::memcpy(tail, batch.data() + offset, batch.size() - offset);
+        index.block(offset, Mark(tail));
+    }
+}
+
+template<auto Mark> void csv_blocks(CsvIndex& index, View batch) {
+    csv_blocks_impl<Mark>(index, batch);
+}
+
+#if defined(__x86_64__)
+template<> __attribute__((target("avx2"))) inline void csv_blocks<csv_avx2>(CsvIndex& index, View batch) {
+    csv_blocks_impl<csv_avx2>(index, batch);
+}
+
+template<> __attribute__((target("avx512bw"))) inline void csv_blocks<csv_avx512>(CsvIndex& index, View batch) {
+    csv_blocks_impl<csv_avx512>(index, batch);
+}
+#endif
+
+template<size_t N, auto Mark, class Row> void scan_indexed(View chunk, Row row) {
+    while (!chunk.empty()) {
+        size_t size = std::min(chunk.size(), CsvIndex::batch_bytes);
+        while (size && chunk[size - 1] != '\n') --size;
+        if (!size) {
+            size_t lf = chunk.find('\n');
+            size = lf == View::npos ? chunk.size() : lf + 1;
+            scan_scalar<N>(chunk.substr(0, size), row);
+        } else {
+            CsvIndex index;
+            {
+                SHOPPING_TIME(timing::Scope markers(timing::MarkerScan);)
+                csv_blocks<Mark>(index, chunk.substr(0, size));
+            }
+            index.parse<N>(chunk.data(), row);
+        }
+        chunk.remove_prefix(size);
+    }
+}
diff --git a/detail_trace.hpp b/detail_trace.hpp
new file mode 100644
index 0000000..3f44489
--- /dev/null
+++ b/detail_trace.hpp
@@ -0,0 +1,242 @@
+#pragma once
+
+#if defined(SHOPPING_DETAIL_TRACE) || defined(SHOPPING_PHASE_COUNTERS)
+#include <algorithm>
+#include <array>
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+#include <time.h>
+
+#ifdef __APPLE__
+#include <mach/mach_time.h>
+#endif
+
+#ifdef __linux__
+#include <linux/perf_event.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+#endif
+
+namespace timing {
+enum Part { Scan, Parse, Validate, Hash, PersonHash, Route, Group, Sessions, Attribution, Encode, Write,
+            MarkerScan, Calibration, Count };
+
+inline bool enabled() {
+    static const bool on = std::getenv("SHOPPING_DETAIL") != nullptr;
+    return on;
+}
+
+struct Time {
+    long long cpu = 0, wall = 0, samples = 0;
+    Time& operator+=(Time b) { cpu += b.cpu; wall += b.wall; samples += b.samples; return *this; }
+    friend Time operator-(Time a, Time b) { return {a.cpu - b.cpu, a.wall - b.wall, a.samples - b.samples}; }
+};
+
+inline long long nanos(clockid_t clock) {
+    timespec ts{};
+    clock_gettime(clock, &ts);
+    return ts.tv_sec * 1'000'000'000LL + ts.tv_nsec;
+}
+inline Time stamp() { return {nanos(CLOCK_THREAD_CPUTIME_ID), nanos(CLOCK_MONOTONIC)}; }
+
+inline long long fine_wall() {
+#ifdef __APPLE__
+    static const auto scale = [] { mach_timebase_info_data_t info; mach_timebase_info(&info); return info; }();
+    return mach_absolute_time() * scale.numer / scale.denom;
+#else
+    return nanos(CLOCK_MONOTONIC);
+#endif
+}
+
+inline long long fine_overhead() {
+    static const long long cost = [] {
+        std::array<long long, 128> trials{};
+        for (auto& trial : trials) {
+            auto start = fine_wall();
+            trial = fine_wall() - start;
+        }
+        std::sort(trials.begin(), trials.end());
+        return trials[trials.size() / 2];
+    }();
+    return cost;
+}
+
+inline Time overhead() {
+    static const Time cost = [] {
+        Time best{1'000'000, 1'000'000};
+        for (int i = 0; i < 128; ++i) {
+            auto start = stamp();
+            auto elapsed = stamp() - start;
+            best.cpu = std::min(best.cpu, elapsed.cpu);
+            best.wall = std::min(best.wall, elapsed.wall);
+        }
+        return best;
+    }();
+    return cost;
+}
+
+inline std::mutex lock;
+inline std::array<Time, Count> global{};
+
+struct Local {
+    std::array<Time, Count> times{};
+    Local* previous;
+    static inline thread_local Local* current = nullptr;
+    static inline thread_local unsigned samples = 0;
+    Local() : previous(current) { if (enabled()) current = this; }
+    ~Local() {
+        if (!enabled()) return;
+        current = previous;
+        std::lock_guard guard(lock);
+        for (size_t i = 0; i < Count; ++i) global[i] += times[i];
+    }
+};
+
+inline unsigned sample(unsigned n) {
+    return Local::current && (++Local::samples % n == 1) ? n : 0;
+}
+
+class Scope {
+    Part part_;
+    Local* local_;
+    unsigned weight_;
+    Time start_;
+    Time nested_cost_{};
+    Scope* parent_ = nullptr;
+    static inline thread_local Scope* current_ = nullptr;
+public:
+    explicit Scope(Part part, unsigned weight = 1)
+        : part_(part), local_(weight ? Local::current : nullptr), weight_(weight) {
+        if (!local_) return;
+        parent_ = current_;
+        current_ = this;
+        start_ = weight_ > 1 ? Time{0, fine_wall()} : stamp();
+    }
+    ~Scope() {
+        if (!local_) return;
+        auto end = weight_ > 1 ? Time{0, fine_wall()} : stamp();
+        auto cost = weight_ > 1 ? Time{0, fine_overhead()} : overhead();
+        auto elapsed = end - start_ - cost - nested_cost_;
+        if (weight_ > 1) elapsed.wall = std::min(elapsed.wall, 5'000LL);
+        local_->times[part_] += {elapsed.cpu * weight_, elapsed.wall * weight_, weight_};
+        current_ = parent_;
+        if (parent_) {
+            parent_->nested_cost_ += nested_cost_;
+            parent_->nested_cost_ += {2 * cost.cpu, 2 * cost.wall};
+        }
+    }
+};
+
+inline void calibrate() {
+    if (!enabled()) return;
+    Local local;
+    for (unsigned i = 0; i < 1024; ++i) {
+        Scope empty(Calibration, 2);
+        asm volatile("" ::: "memory");
+    }
+}
+
+inline void report() {
+    if (!enabled()) return;
+    constexpr const char* names[] = {"scan", "parse", "validate", "hash", "person hash", "route",
+                                     "group", "sessions", "attribution", "encode", "write"};
+    auto split = [](Part parent, long long reserve, std::initializer_list<Part> parts) {
+        long long total = 0;
+        for (auto part : parts) total += global[part].wall;
+        auto& all = global[parent];
+        long long available = std::max(0LL, all.wall - reserve);
+        if (total > available) {
+            for (auto part : parts) global[part].wall = global[part].wall * available / total;
+        }
+        Time used{};
+        for (auto part : parts) {
+            auto& time = global[part];
+            time.cpu = all.wall > 0 ? static_cast<long long>(double(time.wall) * all.cpu / all.wall) : 0;
+            used += time;
+        }
+        all = all - used;
+    };
+    auto empty = global[Calibration];
+    if (empty.samples) {
+        for (auto part : {Parse, Validate, Hash, PersonHash, Route, Attribution}) {
+            auto& time = global[part];
+            time.wall = std::max(0LL, time.wall - (empty.wall * time.samples / empty.samples));
+        }
+    }
+    global[Validate].wall = std::max(0LL, global[Validate].wall - global[PersonHash].wall);
+    global[Hash] += global[PersonHash];
+    split(Scan, global[MarkerScan].wall, {Parse, Validate, Hash, Route});
+    split(Sessions, 0, {Attribution});
+    global[Encode] = global[Encode] - global[Write];
+    for (size_t i = 0; i < std::size(names); ++i) {
+        if (i == PersonHash) continue;
+        std::fprintf(stderr, "detail %s %.3f %.3f\n", names[i],
+                     global[i].cpu / 1e6, global[i].wall / 1e6);
+    }
+}
+
+class Hardware {
+#ifdef __linux__
+    std::array<int, 4> files_{-1, -1, -1, -1};
+    std::array<std::array<unsigned long long, 3>, 4> previous_{};
+
+    void close_all() {
+        for (int& fd : files_) if (fd >= 0) { close(fd); fd = -1; }
+    }
+#endif
+public:
+    Hardware() {
+#ifdef __linux__
+        if (!std::getenv("SHOPPING_PERF")) return;
+        constexpr unsigned events[]{PERF_COUNT_HW_INSTRUCTIONS, PERF_COUNT_HW_CPU_CYCLES,
+                                    PERF_COUNT_HW_CACHE_MISSES, PERF_COUNT_HW_BRANCH_MISSES};
+        for (size_t i = 0; i < files_.size(); ++i) {
+            perf_event_attr attr{};
+            attr.type = PERF_TYPE_HARDWARE;
+            attr.size = sizeof(attr);
+            attr.config = events[i];
+            attr.inherit = 1;
+            attr.exclude_kernel = 1;
+            attr.exclude_hv = 1;
+            attr.read_format = PERF_FORMAT_TOTAL_TIME_ENABLED | PERF_FORMAT_TOTAL_TIME_RUNNING;
+            files_[i] = syscall(SYS_perf_event_open, &attr, 0, -1, -1, PERF_FLAG_FD_CLOEXEC);
+            if (files_[i] >= 0) continue;
+            close_all();
+            break;
+        }
+#endif
+    }
+    void mark([[maybe_unused]] const char* phase) {
+#ifdef __linux__
+        if (files_[0] < 0) return;
+        std::array<unsigned long long, 4> delta{};
+        for (size_t i = 0; i < files_.size(); ++i) {
+            std::array<unsigned long long, 3> value{};
+            if (read(files_[i], value.data(), sizeof(value)) != sizeof(value)) { close_all(); return; }
+            const auto& previous = previous_[i];
+            auto enabled = value[1] - previous[1], running = value[2] - previous[2];
+            auto count = value[0] - previous[0];
+            if (enabled && (!running || running < enabled / 2)) { close_all(); return; }
+            delta[i] = running && running < enabled ? double(count) * enabled / running : count;
+            previous_[i] = value;
+        }
+        std::fprintf(stderr, "perf %s %llu %llu %llu %llu\n", phase,
+                     delta[0], delta[1], delta[2], delta[3]);
+#endif
+    }
+};
+} // namespace timing
+#endif
+
+#ifdef SHOPPING_DETAIL_TRACE
+#define SHOPPING_TIME(...) __VA_ARGS__
+#else
+#define SHOPPING_TIME(...)
+#endif
+
+#ifdef SHOPPING_PHASE_COUNTERS
+#define SHOPPING_COUNT(...) __VA_ARGS__
+#else
+#define SHOPPING_COUNT(...)
+#endif
diff --git a/group_sort.hpp b/group_sort.hpp
new file mode 100644
index 0000000..ee79a0e
--- /dev/null
+++ b/group_sort.hpp
@@ -0,0 +1,175 @@
+#pragma once
+
+#include <numeric>
+
+template<class Value> uint64_t time_key(const Value& value) {
+    if constexpr (std::is_same_v<Value, uint64_t>) return value >> 32;
+    else return uint64_t(value.time) ^ (uint64_t{1} << 63);
+}
+
+template<class Value>
+void sort_timeline(Value* first, Value* last) {
+    constexpr size_t bins = 128;
+    constexpr size_t sort_limit = 768;
+    if (last - first < sort_limit) {
+        if constexpr (std::is_same_v<Value, uint64_t>) std::sort(first, last);
+        else std::sort(first, last, [](const Value& a, const Value& b) { return a.time < b.time; });
+        return;
+    }
+
+    uint64_t low = time_key(*first), high = low;
+    for (auto* p = first + 1; p != last; ++p) {
+        auto key = time_key(*p);
+        low = std::min(low, key);
+        high = std::max(high, key);
+    }
+    if (low == high) return;
+    int shift = std::max(0, int(std::bit_width(low ^ high)) - 7);
+    auto digit = [shift](const Value& value) { return (time_key(value) >> shift) & (bins - 1); };
+    std::array<size_t, bins + 1> boundaries{};
+    for (auto* p = first; p != last; ++p) ++boundaries[digit(*p) + 1];
+    std::partial_sum(boundaries.begin(), boundaries.end(), boundaries.begin());
+    auto next = boundaries;
+    for (size_t bin = 0; bin < bins; ++bin) {
+        while (next[bin] < boundaries[bin + 1]) {
+            auto i = next[bin];
+            auto value = first[i];
+            for (size_t dest; (dest = digit(value)) != bin;)
+                std::swap(value, first[next[dest]++]);
+            first[i] = value;
+            ++next[bin];
+        }
+    }
+    if (shift) for (size_t bin = 0; bin < bins; ++bin) {
+        if (boundaries[bin + 1] - boundaries[bin] > 1)
+            sort_timeline(first + boundaries[bin], first + boundaries[bin + 1]);
+    }
+}
+
+template<class Row, class Less> class SortedRuns {
+    struct Run { std::unique_ptr<Row[]> rows; size_t size = 0; };
+    static constexpr size_t run_rows = (128 << 10) / sizeof(Row);
+    std::vector<Run> runs_;
+    Less less_;
+
+    void sort(Run& run) {
+        std::sort(run.rows.get(), run.rows.get() + run.size, less_);
+    }
+
+public:
+    explicit SortedRuns(Less less) : less_(less) {}
+
+    void append(const Row& row) {
+        if (runs_.empty() || runs_.back().size == run_rows) {
+            if (!runs_.empty()) sort(runs_.back());
+            runs_.push_back({std::make_unique_for_overwrite<Row[]>(run_rows)});
+        }
+        auto& run = runs_.back();
+        run.rows[run.size++] = row;
+    }
+
+    void finish() { if (!runs_.empty()) sort(runs_.back()); }
+    bool empty() const { return runs_.empty(); }
+
+    class Cursor {
+        struct Span { const Row* next; const Row* last; };
+        Less less_;
+        std::vector<Span> heap_;
+        size_t position_ = 0;
+
+    public:
+        explicit Cursor(const SortedRuns& source) : less_(source.less_) {
+            heap_.reserve(source.runs_.size());
+            for (const auto& run : source.runs_)
+                heap_.push_back({run.rows.get(), run.rows.get() + run.size});
+            std::make_heap(heap_.begin(), heap_.end(), [&](Span a, Span b) { return less_(*b.next, *a.next); });
+        }
+
+        bool empty() const { return heap_.empty(); }
+        const Row& front() const { return *heap_.front().next; }
+        size_t position() const { return position_; }
+
+        void pop() {
+            ++position_;
+            auto run = heap_.front();
+            if (++run.next == run.last) {
+                run = heap_.back();
+                heap_.pop_back();
+                if (heap_.empty()) return;
+            }
+            size_t pos = 0;
+            for (size_t child; (child = pos * 2 + 1) < heap_.size(); pos = child) {
+                if (child + 1 < heap_.size() && less_(*heap_[child + 1].next, *heap_[child].next)) ++child;
+                if (!less_(*heap_[child].next, *run.next)) break;
+                heap_[pos] = heap_[child];
+            }
+            heap_[pos] = run;
+        }
+    };
+
+    Cursor cursor() const { return Cursor(*this); }
+};
+
+template<class Row, class Less> class TimeRuns {
+    static constexpr size_t count = 256;
+    using Runs = SortedRuns<Row, Less>;
+    std::vector<Runs> bins_;
+    unsigned shift_;
+
+public:
+    TimeRuns(uint64_t span, Less less) : shift_(std::bit_width((span - 1) / count)) {
+        bins_.reserve(count);
+        for (size_t i = 0; i < count; ++i) bins_.emplace_back(less);
+    }
+
+    void append(uint64_t tick, const Row& row) { bins_[tick >> shift_].append(row); }
+    void finish() { for (auto& bin : bins_) bin.finish(); }
+
+    class Cursor {
+        const std::vector<Runs>& bins_;
+        std::optional<typename Runs::Cursor> current_;
+        size_t bin_ = 0, position_ = 0;
+
+        void next_bin() {
+            current_.reset();
+            while (bin_ < bins_.size()) {
+                const auto& next = bins_[bin_++];
+                if (!next.empty()) {
+                    current_.emplace(next);
+                    return;
+                }
+            }
+        }
+
+    public:
+        explicit Cursor(const TimeRuns& source) : bins_(source.bins_) { next_bin(); }
+        bool empty() const { return !current_; }
+        const Row& front() const { return current_->front(); }
+        size_t position() const { return position_; }
+        void pop() {
+            ++position_;
+            current_->pop();
+            if (current_->empty()) next_bin();
+        }
+    };
+
+    Cursor cursor() const { return Cursor(*this); }
+};
+
+template<class T> struct SpanCursor {
+    const T* values;
+    size_t at, end;
+    bool empty() const { return at == end; }
+    const T& front() const { return values[at]; }
+    size_t position() const { return at; }
+    void pop() { ++at; }
+};
+
+template<class Cursor> struct PersonCursor {
+    Cursor& sorted;
+    Person person;
+    bool empty() const { return sorted.empty() || sorted.front().person != person; }
+    const auto& front() const { return sorted.front().value; }
+    size_t position() const { return sorted.position(); }
+    void pop() { sorted.pop(); }
+};
